# Copy to deploy/compute-staging.env (gitignored); never commit real secrets.
STAGING_ADMIN_USERNAME=staging-admin
STAGING_ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
STAGING_PROXY_PORT=18080

# Fill after generating the 15-minute one-time token in the staging admin UI.
STAGING_WORKER_ENROLLMENT_TOKEN=
STAGING_WORKER_NAME=vps-staging-worker
STAGING_WORKER_MEMORY_LIMIT=3g
STAGING_WORKER_CPUS=2
STAGING_WORKER_THREADS=2
